BOT_ENGINE=codex
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_IDS=123456789
ADMIN_USER_IDS=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ADMIN_USER_IDS=
DATA_DIR=/home/codex/.local/share/agent-bot
DEFAULT_MODEL=gpt-5.4
CODEX_MODELS=
CODEX_BIN=codex
CODEX_HOME=
CODEX_AUTH_PATH=
CODEX_MAX_TURNS=50
CODEX_TIMEOUT=10m
NPM_BIN=npm
WEB_SEARCH=true
LINK_PREFETCH=true
ALLOW_SHELL=false
SHOW_PROGRESS=false
BOT_ENV_FILE=/etc/agent-bot/codex.env
TIMEZONE=Asia/Shanghai
TASK_LIMIT=20
TASK_MIN_INTERVAL=60m
SCRIPT_DIRS=
SCRIPT_TIMEOUT=30m
AUTO_UPGRADE=false
AUTO_UPGRADE_TIME=04:30
UPGRADE_REPO=rshun/agent-bot
