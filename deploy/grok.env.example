BOT_ENGINE=grok
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_IDS=123456789
ADMIN_USER_IDS=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ADMIN_USER_IDS=
DATA_DIR=/home/grok/.local/share/agent-bot
DEFAULT_MODEL=grok-4.7
GROK_MODELS=
GROK_BIN=grok
GROK_HOME=
GROK_AUTH_PATH=
GROK_MAX_TURNS=50
GROK_TIMEOUT=10m
WEB_SEARCH=true
LINK_PREFETCH=true
ALLOW_SHELL=false
SHOW_PROGRESS=false
BOT_ENV_FILE=/etc/agent-bot/grok.env
TIMEZONE=Asia/Shanghai
TASK_LIMIT=20
TASK_MIN_INTERVAL=60m
SCRIPT_DIRS=
SCRIPT_TIMEOUT=30m
AUTO_UPGRADE=false
AUTO_UPGRADE_TIME=04:30
UPGRADE_REPO=rshun/agent-bot
